# DocuMind AI — Root .gitignore
# ─────────────────────────────

# Environment variables — NEVER commit
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker volumes (local dev)
qdrant_data/
upload_data/
uploads/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
